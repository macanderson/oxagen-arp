{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oxagen:proposed:sync-lock:0.2",
  "title": "Proposed Oxagen sync-lock",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "../schemas/sync-lock.schema.json"
    },
    "format_version": {
      "const": "arp.repo/0.2"
    },
    "authority": {
      "const": "informational_only"
    },
    "protected_sync_receipt_id": {
      "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/uuid"
    },
    "tenant_id": {
      "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/uuid"
    },
    "workspace_id": {
      "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/uuid"
    },
    "repository_id": {
      "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/uuid"
    },
    "checkout_binding_id": {
      "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/uuid"
    },
    "target_id": {
      "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/uuid"
    },
    "principal_id": {
      "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/uuid"
    },
    "agent_release_id": {
      "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/uuid"
    },
    "mode_id": {
      "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/uuid"
    },
    "authority_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "applied_at": {
      "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/dateTime"
    },
    "expires_at": {
      "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/dateTime"
    },
    "config_files": {
      "type": "array",
      "items": {
        "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/configFile"
      },
      "minItems": 3,
      "maxItems": 256
    },
    "context_manifest_id": {
      "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/uuid"
    },
    "steering_manifest_id": {
      "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/uuid"
    },
    "policy_revision_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/uuid"
      }
    },
    "source_versions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "entry_key": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/source"
              },
              "resolved_source_version": {
                "type": "string",
                "minLength": 1
              },
              "cleaned_artifact_id": {
                "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/uuid"
              },
              "cleaned_sha256": {
                "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/cleanedSha256"
              },
              "status": {
                "const": "loaded"
              }
            },
            "required": [
              "entry_key",
              "source",
              "resolved_source_version",
              "cleaned_artifact_id",
              "cleaned_sha256",
              "status"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entry_key",
              "status",
              "reason_code"
            ],
            "properties": {
              "entry_key": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "omitted"
              },
              "reason_code": {
                "enum": [
                  "optional_unavailable",
                  "optional_not_selected"
                ]
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 256
    },
    "prepared_tool_belt_id": {
      "$ref": "urn:oxagen:proposed:repo-common:0.2#/$defs/uuid"
    }
  },
  "required": [
    "$schema",
    "format_version",
    "authority",
    "protected_sync_receipt_id",
    "tenant_id",
    "workspace_id",
    "repository_id",
    "checkout_binding_id",
    "target_id",
    "principal_id",
    "agent_release_id",
    "mode_id",
    "authority_epoch",
    "applied_at",
    "expires_at",
    "config_files",
    "context_manifest_id",
    "steering_manifest_id",
    "policy_revision_ids",
    "prepared_tool_belt_id",
    "source_versions"
  ]
}
