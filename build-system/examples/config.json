{
  "version": 1,
  "controlDir": "/srv/oxagen-control",
  "workRoot": "/srv/oxagen-agent-work",
  "manifest": "/srv/oxagen-control/plan.json",
  "runnerDigest": "REPLACE_WITH_INSTALL_DIGEST",
  "phaseZeroCertificate": "/srv/oxagen-control/phase-zero.cert.json",
  "certifierPublicKey": "/srv/oxagen-control/certifier-public.pem",
  "runBudgetCents": 0,
  "maxRunSeconds": 604800,
  "models": {
    "implement": {
      "codex": "gpt-5.3-codex",
      "claude": "claude-sonnet-4-6"
    },
    "review": {
      "codex": "gpt-5.3-codex",
      "claude": "claude-sonnet-4-6"
    }
  },
  "targets": {
    "repository": "CONFIGURE_OWNER/CONFIGURE_REPOSITORY",
    "staging": null,
    "production": null
  },
  "hook": {
    "command": "/srv/oxagen-control/runner/adapters/local-host.sh",
    "args": [
      "/srv/oxagen-control/config.json"
    ],
    "maxSeconds": 14400,
    "env": {
      "PATH": "/usr/local/bin:/usr/bin:/bin"
    }
  },
  "inputManifest": "/srv/oxagen-control/source-inputs.json",
  "inputRoot": "/srv/oxagen-readonly-inputs",
  "adapter": "local",
  "local": {
    "execution": {
      "image": "CONFIGURE_REVIEWED_IMAGE@sha256:CONFIGURE_64_HEX_DIGEST",
      "dockerCommand": "/usr/bin/docker",
      "dockerHost": "unix:///var/run/docker.sock",
      "uid": 1000,
      "gid": 1000,
      "memoryMb": 4096,
      "cpus": 2,
      "pidsLimit": 256,
      "maxOutputTokens": 8192,
      "cli": {
        "codex": {
          "path": "/usr/local/bin/codex",
          "version": "codex-cli 0.155.1"
        },
        "claude": {
          "path": "/usr/local/bin/claude",
          "version": "2.1.278 (Claude Code)"
        }
      },
      "credentials": {
        "openai": {
          "file": "/srv/oxagen-control/secrets/openai.key"
        },
        "anthropic": {
          "file": "/srv/oxagen-control/secrets/anthropic.key"
        }
      },
      "pricingApproval": {
        "profileDigest": "2491406cf7d6a3cd0a37640678e573c27a950e3edbaf6c2db6bed5a2e9b8acaa",
        "expiresAt": "SET_AFTER_REVIEW_AT_MOST_31_DAYS_AHEAD"
      },
      "scanPolicy": {
        "version": "REPLACE_WITH_WORKSPACE_POLICY_REVISION",
        "rules": [
          {
            "match": "REPLACE_WITH_BLOCKED_LITERAL",
            "action": "block"
          },
          {
            "match": "REPLACE_WITH_SENSITIVE_LITERAL",
            "action": "redact"
          },
          {
            "match": "REPLACE_WITH_LOCAL_NAME",
            "action": "replace",
            "replacement": "allowed-name"
          }
        ]
      }
    },
    "github": {
      "repository": "CONFIGURE_OWNER/CONFIGURE_REPOSITORY",
      "repositoryId": 0,
      "hostname": "github.com",
      "defaultBranch": "main",
      "mergeMethod": "squash",
      "ghPath": "/usr/bin/gh",
      "gitPath": "/usr/bin/git",
      "authConfigDir": "/srv/oxagen-control/gh-auth",
      "requiredChecks": [
        {
          "kind": "check_run",
          "name": "CONFIGURE_REQUIRED_JOB",
          "appId": 0
        }
      ],
      "postMergeRequiredChecks": [
        {
          "kind": "check_run",
          "name": "CONFIGURE_DEFAULT_BRANCH_JOB",
          "appId": 0
        }
      ],
      "commandTimeoutSeconds": 30,
      "ciWaitSeconds": 30,
      "tokenFile": "/srv/oxagen-control/secrets/github-writer.key",
      "policyTokenFile": "/srv/oxagen-control/secrets/github-policy-reader.key"
    },
